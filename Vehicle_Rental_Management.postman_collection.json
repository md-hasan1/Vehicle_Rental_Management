{
  "info": {
    "name": "Vehicle Rental API",
    "description": "Postman Collection for Vehicle Rental Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Get All Vehicles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/vehicles?page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "vehicles"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "category",
                  "value": "car",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "Toyota",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Vehicle by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/vehicles/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "vehicles",
                "1"
              ]
            }
          }
        },
        {
          "name": "Create Vehicle",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Toyota Corolla",
                  "type": "text"
                },
                {
                  "key": "plate_number",
                  "value": "DHA-1234",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "car",
                  "type": "text"
                },
                {
                  "key": "daily_rate",
                  "value": "50.00",
                  "type": "text"
                },
                {
                  "key": "photo",
                  "type": "file"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/vehicles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "vehicles"
              ]
            }
          }
        },
        {
          "name": "Update Vehicle",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Toyota Corolla Updated",
                  "type": "text"
                },
                {
                  "key": "daily_rate",
                  "value": "60.00",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/vehicles/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "vehicles",
                "1"
              ]
            }
          }
        },
        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/vehicles/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "vehicles",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Rentals",
      "item": [
        {
          "name": "Get All Rentals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rentals?page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rentals"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "vehicle_id",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "booked",
                  "disabled": true
                },
                {
                  "key": "start_date",
                  "value": "2026-08-01",
                  "disabled": true
                },
                {
                  "key": "end_date",
                  "value": "2026-08-31",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Rental by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rentals/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rentals",
                "1"
              ]
            }
          }
        },
        {
          "name": "Create Rental",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"vehicle_id\": 1,\n    \"customer_name\": \"John Doe\",\n    \"customer_phone\": \"+8801700000000\",\n    \"start_date\": \"2026-08-10\",\n    \"end_date\": \"2026-08-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/rentals",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rentals"
              ]
            }
          }
        },
        {
          "name": "Update Rental",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"completed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/rentals/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rentals",
                "1"
              ]
            }
          }
        },
        {
          "name": "Delete Rental",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rentals/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rentals",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Get Monthly Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/reports/rentals?month=2026-08",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reports",
                "rentals"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "2026-08"
                },
                {
                  "key": "vehicle_id",
                  "value": "1",
                  "disabled": true
                }
              ]
            }
          }
        }
      ]
    }
  ]
}

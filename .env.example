# ── Server ──
PORT=5000

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vehicle_rental
DB_USER=your_user
DB_PASSWORD=your_password_here

# ── Connection Pool ──
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT ──
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30d

# ── File Uploads ──
UPLOAD_PATH=uploads
